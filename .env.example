# Copiez ce fichier en ".env" et remplissez selon le fournisseur que vous voulez utiliser.
# Aucune valeur n'est requise pour tester le projet : par défaut LLM_PROVIDER=mock
# permet de tout faire tourner sans clé API.

# --- Fournisseur LLM ---
# Valeurs possibles : mock | openai | azure_openai | ollama
LLM_PROVIDER=mock
LLM_TEMPERATURE=0.1

# --- OpenAI (si LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Azure OpenAI (si LLM_PROVIDER=azure_openai) ---
# Stack utilisée par VINCI Construction SI (mentionnée dans l'offre de stage) :
# Azure OpenAI Service + Copilot Studio. Une fois ces variables renseignées,
# le reste du projet fonctionne sans aucune modification de code.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<votre-ressource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<nom-du-deploiement>
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Ollama (LLM local, si LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Embeddings ---
# Valeurs possibles :
#   tfidf  -> 100% hors-ligne, aucun téléchargement (par défaut, robuste partout)
#   local  -> sentence-transformers, meilleure qualité sémantique, télécharge un
#             modèle depuis Hugging Face au premier lancement (nécessite Internet)
#   openai -> embeddings OpenAI (nécessite OPENAI_API_KEY)
EMBEDDING_PROVIDER=tfidf
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Paramètres RAG ---
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.25
